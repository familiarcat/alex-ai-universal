{
  "name": "alex-ai-universal",
  "version": "1.0.0",
  "description": "Alex AI Universal - Complete Star Trek crew-based AI assistant suite with zero-artifact guarantee",
  "main": "dist/index.js",
  "bin": {
    "alex-ai": "dist/cli.js",
    "engage-alex-ai": "dist/cli.js",
    "alex": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:extension && npm run build:cli",
    "build:core": "cd ../core && npm run build",
    "build:extension": "cd ../universal-extension && npm run build",
    "build:cli": "cd ../cli && npm run build",
    "dev": "npm run build && npm run dev:watch",
    "dev:watch": "npm run dev:core & npm run dev:extension & npm run dev:cli",
    "dev:core": "cd ../core && npm run dev",
    "dev:extension": "cd ../universal-extension && npm run dev",
    "dev:cli": "cd ../cli && npm run dev",
    "test": "npm run test:core && npm run test:extension && npm run test:cli",
    "test:core": "cd ../core && npm test",
    "test:extension": "cd ../universal-extension && npm test",
    "test:cli": "cd ../cli && npm test",
    "lint": "npm run lint:core && npm run lint:extension && npm run lint:cli",
    "lint:core": "cd ../core && npm run lint",
    "lint:extension": "cd ../universal-extension && npm run lint",
    "lint:cli": "cd ../cli && npm run lint",
    "clean": "npm run clean:core && npm run clean:extension && npm run clean:cli",
    "clean:core": "cd ../core && npm run clean",
    "clean:extension": "cd ../universal-extension && npm run clean",
    "clean:cli": "cd ../cli && npm run clean",
    "install:all": "npm install && cd ../core && npm install && cd ../universal-extension && npm install && cd ../cli && npm install",
    "publish:all": "npm run build && npm run publish:core && npm run publish:extension && npm run publish:cli && npm run publish:meta",
    "publish:core": "cd ../core && npm publish",
    "publish:extension": "cd ../universal-extension && npm publish",
    "publish:cli": "cd ../cli && npm publish",
    "publish:meta": "npm publish"
  },
  "keywords": [
    "ai",
    "code-assistant",
    "star-trek",
    "crew-based",
    "zero-artifacts",
    "universal",
    "cross-platform",
    "vscode",
    "cursor",
    "npx",
    "cli",
    "alex-ai"
  ],
  "author": "Alex AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alex-ai-universal/alex-ai-universal.git"
  },
  "bugs": {
    "url": "https://github.com/alex-ai-universal/alex-ai-universal/issues"
  },
  "homepage": "https://github.com/alex-ai-universal/alex-ai-universal#readme",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@alex-ai/core": "^1.0.0",
    "@alex-ai/universal-extension": "^1.0.0",
    "@alex-ai/cli": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
