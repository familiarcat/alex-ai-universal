{
  "name": "alex-ai-universal",
  "displayName": "Alex AI Universal",
  "description": "Star Trek crew-based AI assistant with zero-artifact guarantee",
  "version": "1.0.0",
  "publisher": "alex-ai",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Snippets"
  ],
  "keywords": [
    "ai",
    "assistant",
    "star-trek",
    "crew-based",
    "zero-artifacts",
    "code-assistant"
  ],
  "dependencies": {
    "@alex-ai/universal-extension": "^1.0.0"
  },
  "activationEvents": [
    "onCommand:alex-ai.engage",
    "onCommand:alex-ai.status",
    "onCommand:alex-ai.openPanel",
    "onCommand:alex-ai.suggest",
    "onCommand:alex-ai.connectProvider",
    "onCommand:alex-ai.disconnectProvider",
    "onCommand:alex-ai.openChat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "alex-ai.engage",
        "title": "Alex AI: Engage",
        "category": "Alex AI"
      },
      {
        "command": "alex-ai.status",
        "title": "Alex AI: Status",
        "category": "Alex AI"
      },
      {
        "command": "alex-ai.openPanel",
        "title": "Alex AI: Open Panel",
        "category": "Alex AI"
      },
      {
        "command": "alex-ai.suggest",
        "title": "Alex AI: Suggest",
        "category": "Alex AI"
      },
      {
        "command": "alex-ai.connectProvider",
        "title": "Alex AI: Connect Provider",
        "category": "Alex AI"
      },
      {
        "command": "alex-ai.disconnectProvider",
        "title": "Alex AI: Disconnect Provider",
        "category": "Alex AI"
      },
      {
        "command": "alex-ai.openChat",
        "title": "Alex AI: Open Chat",
        "category": "Alex AI"
      }
    ],
    "keybindings": [
      {
        "command": "alex-ai.engage",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus"
      },
      {
        "command": "alex-ai.suggest",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "alexAiProviders",
          "name": "Alex AI Providers",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "alex-ai.engage",
          "when": "true"
        },
        {
          "command": "alex-ai.status",
          "when": "true"
        },
        {
          "command": "alex-ai.suggest",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Alex AI Settings",
      "properties": {
        "alexAi.llmProvider": {
          "type": "string",
          "default": "auto",
          "description": "Preferred LLM provider to use (auto, openai, anthropic, local). 'auto' lets Alex AI choose based on cost/latency."
        },
        "alexAi.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Alex AI features in the editor"
        }
        ,
        "alexAi.preferredAssistant": {
          "type": "string",
          "default": "auto",
          "description": "Preferred assistant: alex, copilot, or auto"
        },
        "alexAi.perLanguageEnabled": {
          "type": "object",
          "description": "Enable or disable Alex AI per language id",
          "additionalProperties": { "type": "boolean" }
        }
      }
    }
  },
    "scripts": {
    "compile": "tsc -p tsconfig.json",
    "build": "npm run compile",
    "clean": "rm -rf dist",
    "dev": "code --extensionDevelopmentPath=.",
  "smoke": "node ./test/smoke.js",
  "test:integration": "node ./test/runTest.js",
  "test": "npm run smoke && npm run test:integration",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix"
  },
  "icon": "assets/icon.svg",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.1",
    "mocha": "^11.7.3",
    "typescript": "^4.9.4"
  }
}






