{
  "name": "alex-ai-universal",
  "displayName": "Alex AI Universal",
  "description": "Star Trek crew-based AI assistant with zero-artifact guarantee",
  "version": "1.0.0",
  "publisher": "alex-ai",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Snippets"
  ],
  "keywords": [
    "ai",
    "assistant",
    "star-trek",
    "crew-based",
    "zero-artifacts",
    "code-assistant"
  ],
  "activationEvents": [
    "onCommand:alex-ai.engage",
    "onCommand:alex-ai.status"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "alex-ai.engage",
        "title": "Alex AI: Engage",
        "category": "Alex AI"
      },
      {
        "command": "alex-ai.status",
        "title": "Alex AI: Status",
        "category": "Alex AI"
      }
    ],
    "keybindings": [
      {
        "command": "alex-ai.engage",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "alex-ai.engage",
          "when": "true"
        },
        {
          "command": "alex-ai.status",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "compile": "echo 'Skipping compilation'",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  }
}


