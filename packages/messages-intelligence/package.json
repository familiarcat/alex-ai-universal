{
  "name": "@alex-ai/messages-intelligence",
  "version": "1.0.0",
  "description": "Alex AI Messages Intelligence - Apple Messages conversation analysis and export",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "security-audit": "node security-audit.js",
    "security-audit-refined": "node refined-security-audit.js",
    "rag-security-audit": "node rag-security-audit.js",
    "rag-cleanup": "node rag-cleanup-automation.js",
    "rag-cleanup-aggressive": "node rag-cleanup-automation.js --aggressive",
    "security-automation": "node alex-ai-security-automation.js",
    "security-automation-aggressive": "node alex-ai-security-automation.js --aggressive",
    "bidirectional-rag-demo": "node bidirectional-rag-demo.js"
  },
  "keywords": [
    "alex-ai",
    "messages",
    "conversation-analysis",
    "apple-messages",
    "rag-integration",
    "natural-language",
    "security-audit"
  ],
  "author": "Alex AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alex-ai-universal/alex-ai-universal.git"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "better-sqlite3": "^9.2.2",
    "commander": "^11.1.0",
    "date-fns": "^3.0.6",
    "fs-extra": "^11.2.0",
    "path": "^0.12.7",
    "puppeteer": "^21.5.2",
    "readline-sync": "^1.4.10",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "typescript": "^5.4.5"
  },
  "bin": {
    "alex-ai-messages": "./dist/cli.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
