{
  "name": "alex-ai-cursor-spell-check",
  "displayName": "Alex AI Cursor Spell Check",
  "description": "Real-time spell checking for Cursor AI chat input with Alex AI branding",
  "version": "1.0.0",
  "publisher": "alex-ai",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Machine Learning"
  ],
  "keywords": [
    "spell-check",
    "cursor-ai",
    "alex-ai",
    "real-time",
    "highlighting"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "alex-ai-spell-check.toggle",
        "title": "Toggle Alex AI Spell Check",
        "category": "Alex AI"
      },
      {
        "command": "alex-ai-spell-check.addToDictionary",
        "title": "Add to Dictionary",
        "category": "Alex AI"
      },
      {
        "command": "alex-ai-spell-check.showSuggestions",
        "title": "Show Suggestions",
        "category": "Alex AI"
      }
    ],
    "configuration": {
      "title": "Alex AI Spell Check",
      "properties": {
        "alex-ai-spell-check.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Alex AI spell checking"
        },
        "alex-ai-spell-check.highlightStyle": {
          "type": "string",
          "default": "wavy",
          "enum": ["wavy", "solid", "dashed"],
          "description": "Highlight style for misspelled words"
        },
        "alex-ai-spell-check.showAlexAIBranding": {
          "type": "boolean",
          "default": true,
          "description": "Show Alex AI branding and indicators"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "alex-ai-spell-check.addToDictionary",
          "when": "alex-ai-spell-check.misspelledWord",
          "group": "alex-ai-spell-check"
        },
        {
          "command": "alex-ai-spell-check.showSuggestions",
          "when": "alex-ai-spell-check.misspelledWord",
          "group": "alex-ai-spell-check"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "spellchecker": "^3.7.1"
  }
}
