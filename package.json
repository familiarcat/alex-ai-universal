{
  "name": "alex-ai-universal",
  "version": "1.0.0",
  "description": "Universal AI Code Assistant - Standalone Repository",
  "private": true,
  "workspaces": [],
  "bin": {
    "alex-ai": "bin/alex-ai"
  },
  "scripts": {
    "engage": "bash ./scripts/engage-alex-ai-enhanced.sh",
    "n8n:bridge": "bash scripts/remote-docker-bridge.sh",
    "n8n:sync-remote": "node scripts/n8n-bulk-sync-remote.js",
    "n8n:up": "docker compose -f docker-compose.n8n.yml up -d",
    "n8n:down": "docker compose -f docker-compose.n8n.yml down",
    "n8n:export": "node scripts/n8n-export-all.js",
    "n8n:import-local": "node scripts/n8n-import-to-local.js",
    "bootstrap": "lerna bootstrap",
    "build": "lerna run build",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration",
    "test:n8n-e2e": "node scripts/n8n-e2e-control.js",
    "test:validation": "node scripts/alex-ai-validation-trace.js",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "node e2e-testing-framework.js",
    "test:interactive": "node run-tests.js",
    "test:custom": "node -e \"const {E2ETestingFramework} = require('./e2e-testing-framework'); const f = new E2ETestingFramework(); f.runE2ETest(process.argv[1], 'custom_test');\"",
    "lint": "lerna run lint",
    "clean": "lerna clean",
    "publish": "lerna publish",
    "version": "lerna version",
    "milestone:universal": "./scripts/alex-ai-enhanced-milestone-push-corrected.sh",
    "milestone": "./scripts/alex-ai-enhanced-milestone-push-corrected.sh",
    "milestone:help": "./scripts/alex-ai-enhanced-milestone-push-corrected.sh --help",
    "milestone:enhanced": "./scripts/alex-ai-enhanced-milestone-push-corrected.sh",
    "alex-ai:milestone": "./scripts/alex-ai-enhanced-milestone-push-corrected.sh",
    "install:cursor-spell-check": "./scripts/install-cursor-spell-check.sh",
    "spell-check:install": "./scripts/install-cursor-spell-check.sh",
    "demo": "cd examples/demo-project && node index.js",
    "demo:enhanced": "cd examples/demo-project && node index.js --enhanced",
    "demo:standalone": "cd examples/demo-project && node standalone-enhanced-demo.js",
    "demo:clean": "cd examples/demo-project && node clean-enhanced-demo.js",
    "demo:simple": "cd examples/demo-project && node simple-demo.js",
            "demo:web": "cd examples/demo-project && node src/web-server.js",
            "demo:dashboard": "cd examples/demo-project && node src/dashboard-server.js",
    "demo:live-preview": "cd examples/demo-project && node src/live-preview-server.js",
    "crew:roster": "./scripts/sync-crew-roster.sh",
    "crew:list": "./scripts/sync-crew-roster.sh",
    "crew:sync": "./scripts/sync-crew-roster.sh",
    "start:all": "./start-all-servers.sh",
    "dev:all": "./start-all-servers.sh",
    "ai-learning": "cd examples/ai-learning-platform && node index.js",
    "ai-learning:dev": "cd examples/ai-learning-platform && npm run dev",
    "ai-learning:build": "cd examples/ai-learning-platform && npm run build",
    "universal-demo": "node UNIVERSAL_INTEGRATION_DEMO.js",
    "alex-ai:init": "cd packages/core && npm run alex-ai universal-init",
    "alex-ai:sync": "cd packages/core && npm run alex-ai universal-sync",
    "alex-ai:status": "cd packages/core && npm run alex-ai status",
    "milestone:push": "bash ./scripts/preflight-ship-health.sh --free-ports && bash ./scripts/milestone-push.sh",
    "milestone:one-touch": "bash ./scripts/milestone-one-touch.sh",
    "crew:provision": "bash ./scripts/provision-crew-access.sh",
    "rag:ingest": "node scripts/n8n-post-knowledge.js",
    "rag:verify": "node scripts/n8n-verify-knowledge.js",
    "rag:execs": "node scripts/n8n-verify-execution.js",
    "rag:setup-summary": "node scripts/setup-summary-webhook.js",
    "rag:setup-orchestrator": "node scripts/setup-orchestrator-workflow.js",
    "rag:force-register": "node scripts/n8n-force-register-webhooks.js",
    "rag:run": "node scripts/n8n-run-workflow.js",
    "e2e:verify": "bash ./scripts/e2e-verify-all.sh",
    "innovation:plan": "bash ./scripts/innovation-day-runner.sh",
    "bridge:start": "node ./start-bridged-projects.js",
    "bridge:stop": "lsof -ti:3004,3002,3003 | xargs kill -9 2>/dev/null || true",
    "themes:start": "node ./universal-theme-system/theme-gallery-server.js & node ./universal-theme-system/vibe-quiz-server.js & node ./universal-theme-system/crew-wizard-server.js &",
    "themes:stop": "lsof -ti:3010,3020,3030 | xargs kill -9 2>/dev/null || true",
    "dev:bridge": "npm run themes:start && npm run bridge:start && bash ./start-alex-ai.sh"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@jest/globals": "^29.7.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "lerna": "^8.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "puppeteer": "^23.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/alex-ai-universal.git"
  },
  "keywords": [
    "ai",
    "code-assistant",
    "vscode-extension",
    "cursor-ai",
    "cli",
    "universal"
  ],
  "author": "Alex AI Team",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "chokidar": "^4.0.3"
  }
}
