{
  "name": "alex-ai-universal",
  "version": "1.0.0",
  "description": "Universal AI Code Assistant - Standalone Repository",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "alex-ai": "bin/alex-ai"
  },
  "scripts": {
    "dashboard:setup": "node scripts/automate-dashboard-setup.js",
    "dashboard:watch": "node scripts/start-codebase-watcher.js",
    "admin:setup": "node scripts/automate-admin-setup.js",
    "cursor:memories": "node scripts/crew/coordination/load-crew-memories.js",
    "cursor:prompt": "node scripts/generate-cursor-prompt.js",
    "cursor:layout:capture": "node scripts/capture-cursor-layout.js",
    "cursor:layout:restore": "node scripts/restore-cursor-layout.js",
    "cursor:state:capture": "node scripts/capture-cursor-state.js",
    "cursor:state:recover": "node scripts/recover-cursor-state.js",
    "cursor:test": "bash scripts/test-cursor-startup.sh",
    "openrouter:get-key": "bash scripts/get-openrouter-key.sh",
    "openrouter:verify": "node scripts/verify-openrouter-key.js",
    "openrouter:automate": "node scripts/automate-openrouter-key.js",
    "openrouter:create": "node scripts/automate-openrouter-key.js --create --update-zshrc",
    "openrouter:setup": "bash scripts/setup-openrouter-automation.sh",
    "crew:up": "bash ./scripts/crew-up.sh",
    "engage": "bash ./scripts/engage-alex-ai-enhanced.sh",
    "n8n:bridge": "bash scripts/remote-docker-bridge.sh",
    "n8n:sync-remote": "node scripts/n8n-bulk-sync-remote.js",
    "n8n:restart": "bash scripts/n8n-restart-remote-docker.sh",
    "n8n:activate-workflows": "node scripts/n8n-toggle-workflows-activate-api.js",
    "n8n:activate-all": "node scripts/n8n-toggle-workflows-activate-api.js --all",
    "n8n:full-refresh": "bash scripts/n8n-full-webhook-refresh.sh",
    "n8n:toggle": "node scripts/n8n-toggle-workflows.js",
    "n8n:toggle-all": "node scripts/n8n-toggle-workflows.js --all",
    "n8n:toggle-ssh": "bash scripts/n8n-toggle-workflows-ssh.sh",
    "n8n:toggle-ui": "node scripts/n8n-toggle-workflows-ui.js",
    "n8n:refresh": "npm run n8n:full-refresh",
    "n8n:health": "node scripts/check-webhook-health.js",
    "n8n:up": "docker compose -f docker-compose.n8n.yml up -d",
    "n8n:down": "docker compose -f docker-compose.n8n.yml down",
    "n8n:export": "node scripts/n8n-export-all.js",
    "n8n:import-local": "node scripts/n8n-import-to-local.js",
    "bootstrap": "lerna bootstrap",
    "build": "lerna run build",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration",
    "test:n8n-e2e": "node scripts/n8n-e2e-control.js",
    "test:validation": "node scripts/alex-ai-validation-trace.js",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "node e2e-testing-framework.js",
    "test:interactive": "node run-tests.js",
    "test:custom": "node -e \"const {E2ETestingFramework} = require('./e2e-testing-framework'); const f = new E2ETestingFramework(); f.runE2ETest(process.argv[1], 'custom_test');\"",
    "test:litmus": "node scripts/test-harness/run-litmus-tests.js",
    "test:litmus:all": "node scripts/test-harness/run-litmus-tests.js",
    "test:openrouter": "node scripts/test-openrouter-harness.js",
    "test:openrouter:verbose": "node scripts/test-openrouter-harness.js --verbose",
    "test:openrouter:model": "node scripts/test-openrouter-harness.js --test=model-selection",
    "test:openrouter:coordination": "node scripts/test-openrouter-harness.js --test=task-coordination",
    "test:openrouter:integration": "node scripts/test-openrouter-harness.js --test=integration",
    "crew:verify-parity": "node scripts/crew-verify-mcp-n8n-parity.js",
    "lint": "lerna run lint",
    "clean": "lerna clean",
    "publish": "lerna publish",
    "version": "lerna version",
    "milestone:universal": "./scripts/alex-ai-enhanced-milestone-push-corrected.sh",
    "milestone": "npm run milestone:universal --",
    "milestone:help": "npm run milestone:universal -- --help",
    "milestone:enhanced": "npm run milestone:universal --",
    "alex-ai:milestone": "npm run milestone:universal --",
    "install:cursor-spell-check": "./scripts/install-cursor-spell-check.sh",
    "spell-check:install": "./scripts/install-cursor-spell-check.sh",
    "demo": "cd examples/demo-project && node index.js",
    "demo:enhanced": "cd examples/demo-project && node index.js --enhanced",
    "demo:standalone": "cd examples/demo-project && node standalone-enhanced-demo.js",
    "demo:clean": "cd examples/demo-project && node clean-enhanced-demo.js",
    "demo:simple": "cd examples/demo-project && node simple-demo.js",
    "demo:web": "cd examples/demo-project && node src/web-server.js",
    "demo:dashboard": "cd examples/demo-project && node src/dashboard-server.js",
    "demo:live-preview": "cd examples/demo-project && node src/live-preview-server.js",
    "crew:roster": "./scripts/sync-crew-roster.sh",
    "crew:list": "npm run crew:roster",
    "crew:sync": "npm run crew:roster",
    "ai-learning": "cd examples/ai-learning-platform && node index.js",
    "ai-learning:dev": "cd examples/ai-learning-platform && npm run dev",
    "ai-learning:build": "cd examples/ai-learning-platform && npm run build",
    "universal-demo": "node UNIVERSAL_INTEGRATION_DEMO.js",
    "alex-ai:init": "cd packages/core && npm run alex-ai universal-init",
    "alex-ai:sync": "cd packages/core && npm run alex-ai universal-sync",
    "alex-ai:status": "cd packages/core && npm run alex-ai status",
    "milestone:push": "bash ./scripts/preflight-ship-health.sh --free-ports && bash ./scripts/milestone-push.sh",
    "milestone:one-touch": "bash ./scripts/milestone-one-touch.sh",
    "engage:auto": "bash ./scripts/auto-engage-and-milestone.sh",
    "crew:provision": "bash ./scripts/provision-crew-access.sh",
    "rag:ingest": "node scripts/n8n-post-knowledge.js",
    "rag:verify": "node scripts/n8n-verify-knowledge.js",
    "rag:execs": "node scripts/n8n-verify-execution.js",
    "rag:setup-summary": "node scripts/setup-summary-webhook.js",
    "rag:setup-orchestrator": "node scripts/setup-orchestrator-workflow.js",
    "rag:force-register": "node scripts/n8n-force-register-webhooks.js",
    "rag:run": "node scripts/n8n-run-workflow.js",
    "test:memory": "npm --prefix tests/memory-harness run start",
    "verify:ddd": "NODE_PATH=./node_modules node scripts/ci-verify-client-n8n-supabase.js",
    "e2e:verify": "bash ./scripts/e2e-verify-all.sh",
    "innovation:plan": "bash ./scripts/innovation-day-runner.sh",
    "bridge:start": "node ./start-bridged-projects.js",
    "bridge:stop": "lsof -ti:3004,3002,3003,3006 | xargs kill -9 2>/dev/null || true",
    "themes:start": "node ./universal-theme-system/theme-gallery-server.js & node ./universal-theme-system/vibe-quiz-server.js & node ./universal-theme-system/crew-wizard-server.js &",
    "themes:stop": "lsof -ti:3010,3020,3030 | xargs kill -9 2>/dev/null || true",
    "dev:bridge": "npm run themes:start && npm run bridge:start && bash ./start-alex-ai.sh",
    "local:e2e": "bash ./scripts/local-e2e-setup.sh",
    "local:chat": "node bin/alex-ai chat",
    "local:engage": "node bin/alex-ai engage \"$MESSAGE\"",
    "ports:kill": "bash ./scripts/kill-ports.sh",
    "dashboard:dev:clean": "bash ./scripts/kill-ports.sh && cd dashboard && npm run dev:n8n"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^20.12.7",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "lerna": "^8.0.0",
    "pg": "^8.16.3",
    "prettier": "^3.2.5",
    "puppeteer": "^23.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/alex-ai-universal.git"
  },
  "keywords": [
    "ai",
    "code-assistant",
    "vscode-extension",
    "cursor-ai",
    "cli",
    "universal"
  ],
  "author": "Alex AI Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@octokit/rest": "^21.0.0",
    "@supabase/supabase-js": "^2.81.1",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0-rc.12",
    "chokidar": "^4.0.3",
    "compression": "^1.8.1",
    "ejs": "^3.1.10",
    "express-rate-limit": "^8.2.1",
    "socket.io": "^4.8.1"
  }
}
