      {
        "parameters": {
          "functionCode": "// Extract projectId from query params\nconst query = $input.item.json.query;\nconst projectId = query?.projectId;\n\nif (!projectId) {\n  throw new Error('projectId query parameter is required');\n}\n\nconsole.log('🔍 Retrieving project:', projectId);\n\nreturn { json: { project_id: projectId } };"
        },
        "id": "extract-params",
        "name": "Extract Params",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [
          464,
          304
        ]
      },
      {
        "parameters": {
          "operation": "get",
          "tableId": "projects",
          "filters": {
            "conditions": [
              {
                "keyName": "project_id",
                "keyValue": "={{ $json.project_id }}"
              },
              {
                "keyName": "deleted_at",
                "keyValue": "is.null"
              }
            ]
          },
          "table": "projects",
          "filterType": "manual",
          "matchType": "matchAll",
          "options": {
            "limit": 1
          }
        },
        "id": "supabase-select",
        "name": "Supabase Select",
        "type": "n8n-nodes-base.supabase",
