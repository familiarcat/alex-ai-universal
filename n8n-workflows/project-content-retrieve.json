{
  "name": "Project Content Retrieve",
  "nodes": [
    {
      "parameters": {
        "path": "project-content-retrieve",
        "httpMethod": "GET",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "project-content-retrieve"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.query.projectId}}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{$json.headers['x-source']}}",
              "value2": "alex-ai-dashboard"
            }
          ]
        }
      },
      "id": "validate-input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM project_content WHERE project_id = $1 AND deleted_at IS NULL;",
        "parameters": {
          "values": [
            {
              "name": "$1",
              "value": "={{$json.query.projectId}}"
            }
          ]
        }
      },
      "id": "supabase-select",
      "name": "Supabase Select",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [650, 200],
      "credentials": {
        "postgres": {
          "id": "supabase-postgres",
          "name": "Supabase PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.length}}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "check-found",
      "name": "Check Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json[0]}}"
      },
      "id": "response-success",
      "name": "Response Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 404,
        "responseBody": "={{ { \"success\": false, \"error\": \"Project not found\" } }}"
      },
      "id": "response-not-found",
      "name": "Response Not Found",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 400,
        "responseBody": "={{ { \"success\": false, \"error\": \"Invalid input: missing projectId\" } }}"
      },
      "id": "response-error",
      "name": "Response Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 400]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{"node": "Validate Input", "type": "main", "index": 0}]]
    },
    "Validate Input": {
      "main": [
        [{"node": "Supabase Select", "type": "main", "index": 0}],
        [{"node": "Response Error", "type": "main", "index": 0}]
      ]
    },
    "Supabase Select": {
      "main": [[{"node": "Check Found", "type": "main", "index": 0}]]
    },
    "Check Found": {
      "main": [
        [{"node": "Response Success", "type": "main", "index": 0}],
        [{"node": "Response Not Found", "type": "main", "index": 0}]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "tags": ["alex-ai", "project-content", "ddd"],
  "meta": {
    "description": "Retrieve user project content from Supabase. Part of proper DDD flow: Supabase => n8n => Client",
    "author": "Alex AI Crew"
  }
}

