{
  "name": "Project Content Retrieve (Supabase => Dashboard)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "project-content-retrieve",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "// Extract projectId from query params
const query = $input.item.json.query;
const projectId = query?.projectId;

if (!projectId) {
  throw new Error('projectId query parameter is required');
}

console.log('🔍 Retrieving project:', projectId);

return { json: { project_id: projectId } };"
      },
      "id": "extract-params",
      "name": "Extract Params",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "table": "projects",
        "filterType": "manual",
        "matchType": "matchAll",
        "filters": {
          "conditions": [
            {
              "keyName": "project_id",
              "keyValue": "={{ $json.project_id }}"
            },
            {
              "keyName": "deleted_at",
              "keyValue": "is.null"
            }
          ]
        },
        "options": {
          "limit": 1
        }
      },
      "id": "supabase-select",
      "name": "Supabase Select",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        650,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase Account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "check-found",
      "name": "Check Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "// Transform Supabase data to dashboard format
const project = $input.item.json;

const result = {
  projectId: project.project_id,
  headline: project.headline,
  subheadline: project.subheadline,
  description: project.description,
  theme: project.theme,
  projectType: project.project_type,
  businessType: project.business_type,
  components: project.components ? JSON.parse(project.components) : [],
  pages: project.pages ? JSON.parse(project.pages) : {},
  updatedAt: new Date(project.updated_at).getTime()
};

return { json: result };"
      },
      "id": "transform-response",
      "name": "Transform Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1050,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "response-success",
      "name": "Response Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1250,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"Project not found\", \"projectId\": $('Extract Params').item.json.project_id } }}",
        "options": {
          "responseCode": 404
        }
      },
      "id": "response-not-found",
      "name": "Response Not Found",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1250,
        400
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Extract Params",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Params": {
      "main": [
        [
          {
            "node": "Supabase Select",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase Select": {
      "main": [
        [
          {
            "node": "Check Found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Found": {
      "main": [
        [
          {
            "node": "Transform Response",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Response Not Found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform Response": {
      "main": [
        [
          {
            "node": "Response Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
