{
  "version": "1.0.0",
  "description": "Alex AI Universal Litmus Test Definitions - Reusable test cases for end-to-end system validation",
  "tests": [
    {
      "id": "litmus-001",
      "name": "Supabase Migration Automation Test",
      "description": "Verifies Supabase migration automation by checking migration status and files (read-only)",
      "naturalLanguagePrompt": "verify supabase migrations",
      "expectedBehavior": "All migrations applied and verified",
      "functionalRole": "infrastructure",
      "testSteps": [
        {
          "type": "cli_command",
          "name": "Check migration status (read-only)",
          "command": "supabase migration list",
          "expectedOutput": "Local"
        },
        {
          "type": "file_check",
          "name": "Verify consolidated migration file exists",
          "path": "supabase/CONSOLIDATED_MIGRATION.sql",
          "expectedContent": "CONSOLIDATED SUPABASE MIGRATION"
        },
        {
          "type": "file_check",
          "name": "Verify migration automation script exists",
          "path": "scripts/run-all-supabase-migrations.js",
          "expectedContent": "RUNNING ALL SUPABASE MIGRATIONS"
        }
      ],
      "verificationSteps": [
        {
          "type": "api_call",
          "name": "Verify table accessibility",
          "endpoint": "https://rpkkkbufdwxmjaerbhbn.supabase.co/rest/v1/alex_ai_memories?limit=1",
          "method": "GET",
          "expectedStatus": 200
        }
      ],
      "memoryVerification": {
        "enabled": true,
        "verifyStorage": true,
        "verifyFunctionalRole": true
      },
      "tags": ["supabase", "migrations", "infrastructure", "automation"],
      "priority": "high",
      "version": "1.0.0"
    },
    {
      "id": "litmus-002",
      "name": "Chat Session Memory Storage Test",
      "description": "Verifies chat session memory storage by querying existing memories (read-only)",
      "naturalLanguagePrompt": "verify chat session memory storage",
      "expectedBehavior": "Chat session memories found in system",
      "functionalRole": "memory",
      "testSteps": [
        {
          "type": "file_check",
          "name": "Verify memory storage script exists",
          "path": "scripts/store-current-chat-session.js",
          "expectedContent": "STORING CHAT SESSION"
        },
        {
          "type": "memory_query",
          "name": "Query existing chat session memories",
          "query": "chat session",
          "expectedResults": {
            "minCount": 0
          }
        },
        {
          "type": "api_call",
          "name": "Verify Supabase memory table accessible",
          "endpoint": "https://rpkkkbufdwxmjaerbhbn.supabase.co/rest/v1/alex_ai_memories?limit=1",
          "method": "GET",
          "expectedStatus": 200
        }
      ],
      "verificationSteps": [
        {
          "type": "api_call",
          "name": "Verify N8N workflow accessible",
          "endpoint": "https://n8n.pbradygeorgen.com/webhook/crew-memory-storage",
          "method": "POST",
          "expectedStatus": 200
        }
      ],
      "memoryVerification": {
        "enabled": true,
        "verifyStorage": true,
        "verifyFunctionalRole": true
      },
      "tags": ["memory", "vector-embeddings", "n8n", "chat-session"],
      "priority": "high",
      "version": "1.0.0"
    },
    {
      "id": "litmus-003",
      "name": "Milestone Push Automation Test",
      "description": "Verifies automated milestone push system by checking git history (read-only)",
      "naturalLanguagePrompt": "verify milestone push history",
      "expectedBehavior": "Recent milestone commits found in git history",
      "functionalRole": "automation",
      "testSteps": [
        {
          "type": "cli_command",
          "name": "Check recent milestone commits in git history",
          "command": "git log --oneline --grep='milestone' -10",
          "expectedOutput": "milestone"
        },
        {
          "type": "cli_command",
          "name": "Verify milestone script exists",
          "command": "test -f scripts/alex-ai-enhanced-milestone-push-corrected.sh && echo 'exists'",
          "expectedOutput": "exists"
        },
        {
          "type": "file_check",
          "name": "Verify milestone script is executable",
          "path": "scripts/alex-ai-enhanced-milestone-push-corrected.sh",
          "expectedContent": "Alex AI Enhanced Milestone Push"
        }
      ],
      "verificationSteps": [],
      "memoryVerification": {
        "enabled": true,
        "verifyStorage": true,
        "verifyFunctionalRole": true
      },
      "tags": ["milestone", "automation", "git", "ci-cd"],
      "priority": "high",
      "version": "1.0.0"
    },
