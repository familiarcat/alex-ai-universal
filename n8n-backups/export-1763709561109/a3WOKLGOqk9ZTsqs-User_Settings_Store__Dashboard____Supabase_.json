  "id": "a3WOKLGOqk9ZTsqs",
  "name": "User Settings Store (Dashboard => Supabase)",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "settings-store",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "// Validate and transform user settings\nconst body = $input.item.json.body;\n\n// Use 'default' user for MVP (single-user system)\nconst userId = body.userId || 'default';\n\n// Validate globalTheme is provided\nif (!body.globalTheme) {\n  throw new Error('globalTheme is required');\n}\n\n// Build settings data\nconst settingsData = {\n  user_id: userId,\n  global_theme: body.globalTheme,\n  preferences: body.preferences ? JSON.stringify(body.preferences) : '{}',\n  updated_at: new Date().toISOString()\n};\n\nconsole.log('⚙️ Storing settings for user:', settingsData.user_id, '| Theme:', settingsData.global_theme);\n\nreturn { json: settingsData };"
      },
      "id": "validate-transform",
      "name": "Validate & Transform",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "user_settings",
        "columns": "user_id,global_theme,preferences,updated_at",
        "options": {
          "onConflict": "user_id",
          "skipOnConflict": false,
          "upsert": true
        }
      },
      "id": "supabase-upsert",
      "name": "Supabase Upsert",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        650,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase Account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"userId\": $json.user_id, \"globalTheme\": $json.global_theme, \"message\": \"Settings stored successfully\", \"timestamp\": $now } }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "response-success",
      "name": "Response Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": false, \"error\": $json.error, \"message\": \"Failed to store settings\" } }}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "response-error",
      "name": "Response Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        850,
        450
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
