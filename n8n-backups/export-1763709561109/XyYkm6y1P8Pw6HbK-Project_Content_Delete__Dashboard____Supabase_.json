    {
      "parameters": {
        "functionCode": "// Validate projectId\nconst body = $input.item.json.body;\n\nif (!body.projectId) {\n  throw new Error('projectId is required');\n}\n\nconsole.log('🗑️ Soft-deleting project:', body.projectId);\n\nreturn { \n  json: { \n    project_id: body.projectId,\n    deleted_at: new Date().toISOString()\n  } \n};"
      },
      "id": "validate-input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "table": "projects",
        "updateKey": "project_id",
        "columnsToUpdate": "deleted_at",
        "options": {}
      },
      "id": "supabase-soft-delete",
      "name": "Supabase Soft Delete",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        650,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase Account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"projectId\": $('Validate Input').item.json.project_id, \"message\": \"Project deleted successfully\", \"timestamp\": $now } }}",
        "options": {
          "responseCode": 200
        }
      },
