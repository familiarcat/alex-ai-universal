#!/usr/bin/env node
"use strict";

const { spawnSync } = require('node:child_process');
const path = require('node:path');

function run(script, args = []) {
  const scriptPath = path.join(__dirname, '..', 'scripts', script);
  const res = spawnSync(process.execPath, [scriptPath, ...args], { stdio: 'inherit', env: process.env });
  process.exitCode = res.status || 0;
}

const [, , cmd, ...rest] = process.argv;

switch (cmd) {
  case 'init':
    run('cli-init.js', rest);
    break;
  case 'verify':
    run('cli-verify.js', rest);
    break;
  case 'triage':
    run('cli-triage.js', rest);
    break;
  default: {
    console.log('Alex AI CLI');
    console.log('Usage:');
    console.log('  alex-ai init            # add workflow and env templates to current repo');
    console.log('  alex-ai verify          # preflight check for secrets and permissions');
    console.log('  alex-ai triage [--item <number>|--all]  # triage issues/PRs locally');
    process.exitCode = 0;
  }
}


